# Backend config (all optional - with none set the backend runs in DEMO mode)
PORT=8787
# Shared secret the app sends as x-app-token. Set it before exposing the backend publicly.
APP_TOKEN=

# Telegram bot (create with @BotFather). Message the bot /start once: that chat becomes the owner chat.
TELEGRAM_BOT_TOKEN=
# Optional comma separated chat ids that count as "supported conversations" for Send it
ALLOWED_CHAT_IDS=

# Any OpenAI compatible endpoint (OpenAI, Groq, ...) for intent parsing, summaries and drafts
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Speech to text (defaults to the LLM key/base). Groq example: whisper-large-v3-turbo
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=whisper-1

# Calendar: a secret iCal (.ics) URL, e.g. Google Calendar "secret address in iCal format"
ICS_URL=
